{
  "name": "knight-rider-kitt",
  "displayName": "Knight Rider KITT",
  "description": "Knight Rider KITT: a Copilot-style AI pair programmer for VS Code with streaming chat, a ranked workspace-context engine, inline code actions, and one-command handoff from GitHub Copilot. Tuned for large monorepos: scoped diagnostics, bounded file reads, and a debounced mention index.",
  "version": "2.2.0",
  "publisher": "knightrider",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "kitt",
    "copilot",
    "chat",
    "groq",
    "llm",
    "pair programming",
    "context engine"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:knightriderSidebar",
    "onCommand:knightrider.chat.focus",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Knight Rider KITT will not run terminal commands, send workspace files to the model, or apply edits to your files."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "knightriderContainer",
          "title": "Knight Rider KITT",
          "icon": "media/knightrider.svg"
        }
      ]
    },
    "views": {
      "knightriderContainer": [
        {
          "type": "webview",
          "id": "knightriderSidebar",
          "name": "Knight Rider KITT",
          "contextualTitle": "Knight Rider KITT"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "knightrider.chat",
        "name": "kitt",
        "fullName": "Knight Rider KITT",
        "description": "Ask Knight Rider KITT about your code, get explanations, fixes, tests and reviews from any file or selection.",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain the referenced code"
          },
          {
            "name": "fix",
            "description": "Find and fix problems in the referenced code"
          },
          {
            "name": "tests",
            "description": "Write unit tests for the referenced code"
          },
          {
            "name": "docs",
            "description": "Write documentation for the referenced code"
          },
          {
            "name": "review",
            "description": "Review the referenced code for bugs and risks"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "knightrider.chat.focus",
        "title": "Open Chat",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.chat.newChat",
        "title": "New Chat",
        "category": "Knight Rider KITT",
        "icon": "$(add)"
      },
      {
        "command": "knightrider.chat.ask",
        "title": "Ask Knight Rider KITT",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.chat.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.chat.editLastMessage",
        "title": "Edit Last Message",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.chat.history",
        "title": "Chat History",
        "category": "Knight Rider KITT",
        "icon": "$(history)"
      },
      {
        "command": "knightrider.key.set",
        "title": "Set API Key",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.key.clear",
        "title": "Clear API Key",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.model.select",
        "title": "Select Model",
        "category": "Knight Rider KITT",
        "icon": "$(chip)"
      },
      {
        "command": "knightrider.action.explain",
        "title": "Explain This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.action.fix",
        "title": "Fix Errors in This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.action.tests",
        "title": "Write Tests for This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.action.document",
        "title": "Document This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.action.refactor",
        "title": "Refactor This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.action.review",
        "title": "Review This File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.diagnostics.fixAll",
        "title": "Fix Problems in Workspace",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.code.copy",
        "title": "Copy Code Block",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.code.applyToFile",
        "title": "Apply Code to File",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.code.insertAtCursor",
        "title": "Insert Code at Cursor",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.code.preview",
        "title": "Preview Changes",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.terminal.run",
        "title": "Run Command in Terminal",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.copilot.switch",
        "title": "Switch from Copilot to Knight Rider KITT",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.copilot.reportLimit",
        "title": "I Ran Out of Copilot Tokens",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.copilot.clearLimit",
        "title": "Copilot Tokens Refreshed",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.copilot.status",
        "title": "Show Copilot & Knight Rider KITT Status",
        "category": "Knight Rider KITT"
      },
      {
        "command": "knightrider.config.open",
        "title": "Open Settings",
        "category": "Knight Rider KITT"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "knightrider.chat.newChat",
          "when": "view == knightriderSidebar",
          "group": "navigation@1"
        },
        {
          "command": "knightrider.chat.history",
          "when": "view == knightriderSidebar",
          "group": "navigation@2"
        },
        {
          "command": "knightrider.model.select",
          "when": "view == knightriderSidebar",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "knightrider.chat.history",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "knightrider.chat.askAboutSelection",
          "when": "editorHasSelection",
          "group": "1_modification@100"
        }
      ],
      "commandPalette": [
        {
          "command": "knightrider.code.copy",
          "when": "false"
        },
        {
          "command": "knightrider.code.applyToFile",
          "when": "false"
        },
        {
          "command": "knightrider.code.insertAtCursor",
          "when": "false"
        },
        {
          "command": "knightrider.code.preview",
          "when": "false"
        },
        {
          "command": "knightrider.terminal.run",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Knight Rider KITT",
      "properties": {
        "knightrider.apiBaseUrl": {
          "type": "string",
          "default": "https://api.groq.com/openai/v1",
          "markdownDescription": "OpenAI-compatible API base URL. Point this at any compatible provider (Groq, OpenRouter, Together, Ollama, LM Studio) to switch backends.",
          "scope": "machine"
        },
        "knightrider.model": {
          "type": "string",
          "default": "openai/gpt-oss-120b",
          "description": "Model id sent to the provider.",
          "scope": "window"
        },
        "knightrider.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature. Lower is more deterministic and better for code."
        },
        "knightrider.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 32768,
          "description": "Maximum tokens to generate per response."
        },
        "knightrider.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Stream responses token by token as they arrive."
        },
        "knightrider.systemPrompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "Extra instructions appended to the built-in system prompt."
        },
        "knightrider.includeCurrentFile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically include the file you are editing in every request."
        },
        "knightrider.includeSelection": {
          "type": "boolean",
          "default": true,
          "description": "Automatically include the current selection in every request."
        },
        "knightrider.maxContextFiles": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 25,
          "description": "How many @-mentioned files to attach to a request."
        },
        "knightrider.maxFileContextChars": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "maximum": 200000,
          "description": "Character budget for automatic file context before truncation."
        },
        "knightrider.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "Search the workspace for files relevant to your question when you have not @-mentioned anything."
        },
        "knightrider.confirmBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before writing model-generated code into your files."
        },
        "knightrider.confirmBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before running a model-generated terminal command."
        },
        "knightrider.saveHistory": {
          "type": "boolean",
          "default": true,
          "description": "Persist conversations between sessions."
        },
        "knightrider.maxSavedConversations": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 200,
          "description": "How many past conversations to keep."
        },
        "knightrider.copilot.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item with the active model and a Copilot handoff shortcut."
        },
        "knightrider.copilot.autoHandoff": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When you report that Copilot ran out of tokens, Knight Rider KITT switches over and offers to continue the same task."
        },
        "knightrider.copilot.handoffContext": {
          "type": "boolean",
          "default": true,
          "description": "Attach the active selection and clipboard text when switching over from Copilot."
        },
        "knightrider.telemetryNotice": {
          "type": "boolean",
          "default": true,
          "description": "Show the one-time notice explaining that your code is sent to the configured model provider."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "node test/run.cjs",
    "pretest": "npm run compile",
    "package": "vsce package --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.29.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
